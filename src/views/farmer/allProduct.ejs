<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Farm — Bihari Kisan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/farmerCss/allProduct.css">
</head>
<body>

<div class="app-shell">

  <!-- ================= SIDEBAR (Bihari Kisan) ================= -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="logo-mark">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12c0-4 2-7 6-8-1 4-2 7-6 8Z"/><path d="M12 12C12 8 10 5 6 4c1 4 2 7 6 8Z"/></svg>
      </div>
      <div>
        <div class="brand-text">BIHARI KISAN</div>
        <div class="brand-sub">Farmer Dashboard</div>
      </div>
    </div>

    <a class="nav-link" href="/farmerDash">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
      Dashboard
    </a>

    <a class="nav-link active" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20v-8"/><path d="M12 12c0-3.5 1.8-6 5-7-1 3.5-1.8 6-5 7Z"/><path d="M12 12c0-3.5-1.8-6-5-7 1 3.5 1.8 6 5 7Z"/><path d="M6 20h12"/></svg>
      My Farm
    </a>

    <a class="nav-link" href="farnerproduct">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16l-1.5 10.5a2 2 0 0 1-2 1.5H7.5a2 2 0 0 1-2-1.5Z"/><path d="M8 9V7a4 4 0 0 1 8 0v2"/></svg>
      Sell My Crop
    </a>

    <a class="nav-link" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2"/><path d="M12 19v2"/><path d="M4.2 4.2l1.4 1.4"/><path d="M18.4 18.4l1.4 1.4"/><path d="M3 12h2"/><path d="M19 12h2"/><path d="M4.2 19.8l1.4-1.4"/><path d="M18.4 5.6l1.4-1.4"/></svg>
      Weather &amp; Advisory
    </a>

    <a class="nav-link" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>
      Soil &amp; Irrigation
    </a>

    <a class="nav-link" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
      Market Prices
    </a>

    <a class="nav-link" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l9-6 9 6"/><path d="M5 10v9"/><path d="M9 10v9"/><path d="M15 10v9"/><path d="M19 10v9"/><path d="M3 21h18"/></svg>
      Government Schemes
    </a>

    <a class="nav-link" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.5 8.5c0-1.5 1.5-2.5 3.5-2.5s3.5 1 3.5 2.5-3.5 1.5-3.5 4"/><circle cx="12" cy="12" r="2.4"/></svg>
      Help &amp; Support
    </a>

    <a class="nav-link" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 1 1-4 0v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.6 1H21a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.6 1z"/></svg>
      Settings
    </a>

    <div class="sidebar-footer">
      <a class="nav-link logout" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="main-area">
    <!-- ================= TOPBAR ================= -->
    <header class="topbar">
      <div class="topbar-left">
        <button class="hamburger" id="hamburgerBtn" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="topbar-title">My Farm</div>
      </div>
      <div class="topbar-right">
        <button class="topbar-icon-btn" aria-label="Notifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        </button>
        <div class="avatar">RS</div>
      </div>
    </header>

    <div class="content">

      <!-- ================= MY PRODUCTS SECTION ================= -->
      <section class="card products-section">

        <div class="section-header">
          <div class="section-heading">
            <h2>My Products</h2>
            <p>Manage all the products you have listed for sale.</p>
          </div>
          <button class="btn-sell" id="addProductBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add New Product
          </button>
        </div>

        <!-- demo toggles (optional preview aid, safe to delete) -->
        <div class="dev-toggle">
          <button data-demo="normal" class="on">Normal</button>
          <button data-demo="loading">Loading state</button>
          <button data-demo="empty">Empty state</button>
        </div>

        <!-- Summary cards -->
        <div class="stat-grid" id="statGrid">
          <div class="stat-card">
            <div class="stat-icon tone-neutral">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </div>
            <div>
              <div class="stat-value" id="statTotal">24</div>
              <div class="stat-label">Total Products</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon tone-success">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
              <div class="stat-value" id="statActive">18</div>
              <div class="stat-label">Active Listings</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon tone-warning">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div>
              <div class="stat-value" id="statLow">4</div>
              <div class="stat-label">Low Stock</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon tone-error">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <div>
              <div class="stat-value" id="statSold">2</div>
              <div class="stat-label">Sold Out</div>
            </div>
          </div>
        </div>

        <!-- Toolbar -->
        <div class="toolbar">
          <div class="search-field">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchInput" placeholder="Search your products...">
          </div>
          <select class="filter-select" id="categoryFilter">
            <option value="all">All Categories</option>
            <option value="Vegetables">Vegetables</option>
            <option value="Fruits">Fruits</option>
            <option value="Grains">Grains</option>
            <option value="Pulses">Pulses</option>
            <option value="Spices">Spices</option>
            <option value="Dairy">Dairy</option>
            <option value="Other">Other</option>
          </select>
          <select class="filter-select" id="statusFilter">
            <option value="all">All Status</option>
            <option value="active">Active</option>
            <option value="lowstock">Low Stock</option>
            <option value="soldout">Sold Out</option>
            <option value="draft">Draft</option>
          </select>
          <select class="filter-select" id="sortFilter">
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="stock-asc">Stock: Low to High</option>
          </select>
        </div>

        <!-- Product grid -->
        <div class="product-grid" id="productGrid"></div>

        <!-- Pagination -->
        <div class="pagination-row" id="paginationRow">
          <div class="pagination-info" id="paginationInfo">Showing 1–9 of 24 products</div>
          <div class="pagination-controls" id="paginationControls"></div>
        </div>

      </section>

    </div>
  </div>
</div>

<!-- ================= ADD / EDIT MODAL ================= -->
<div class="modal-overlay" id="productModalOverlay">
  <div class="modal">
    <div class="modal-header">
      <h3 id="productModalTitle">Add New Product</h3>
      <button class="modal-close" id="productModalClose" aria-label="Close">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <form id="productForm">
        <div class="form-row">
          <label for="fProductName">Product Name</label>
          <input type="text" id="fProductName" required placeholder="e.g. Fresh Organic Tomato">
        </div>
        <div class="form-grid-2">
          <div class="form-row">
            <label for="fCategory">Category</label>
            <select id="fCategory">
              <option>Vegetables</option>
              <option>Fruits</option>
              <option>Grains</option>
              <option>Pulses</option>
              <option>Spices</option>
              <option>Dairy</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-row">
            <label for="fStatus">Status</label>
            <select id="fStatus">
              <option value="active">Active</option>
              <option value="lowstock">Low Stock</option>
              <option value="soldout">Sold Out</option>
              <option value="draft">Draft</option>
            </select>
          </div>
        </div>
        <div class="form-grid-2">
          <div class="form-row">
            <label for="fPrice">Price per kg (₹)</label>
            <input type="number" id="fPrice" min="0" step="0.5" required placeholder="40">
          </div>
          <div class="form-row">
            <label for="fUnit">Unit</label>
            <select id="fUnit">
              <option>kg</option>
              <option>litre</option>
              <option>dozen</option>
              <option>piece</option>
            </select>
          </div>
        </div>
        <div class="form-grid-2">
          <div class="form-row">
            <label for="fStock">Current Stock</label>
            <input type="number" id="fStock" min="0" required placeholder="50">
          </div>
          <div class="form-row">
            <label for="fCapacity">Max Stock Capacity</label>
            <input type="number" id="fCapacity" min="0" required placeholder="100">
          </div>
        </div>
        <div class="form-row">
          <label for="fImage">Image URL</label>
          <input type="text" id="fImage" placeholder="https://... (optional)">
          <div class="form-hint">Leave blank to use a placeholder image.</div>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" id="productCancelBtn">Cancel</button>
      <button class="btn-sell" id="productSaveBtn">Save Product</button>
    </div>
  </div>
</div>

<!-- ================= VIEW MODAL ================= -->
<div class="modal-overlay" id="viewModalOverlay">
  <div class="modal">
    <div class="modal-header">
      <h3>Product Details</h3>
      <button class="modal-close" id="viewModalClose" aria-label="Close">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body" id="viewModalBody"></div>
    <div class="modal-footer">
      <button class="btn-outline" id="viewCloseBtn">Close</button>
      <button class="btn-sell" id="viewEditBtn">Edit Product</button>
    </div>
  </div>
</div>

<!-- ================= DELETE CONFIRM MODAL ================= -->
<div class="modal-overlay" id="deleteModalOverlay">
  <div class="modal" style="max-width:400px;">
    <div class="modal-body" style="text-align:center; padding-top:28px;">
      <div class="confirm-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      </div>
      <h3 style="margin:0 0 8px;">Delete this product?</h3>
      <p style="margin:0; font-size:13.5px; color:var(--muted);" id="deleteProductName">This action cannot be undone.</p>
    </div>
    <div class="modal-footer" style="justify-content:center;">
      <button class="btn-outline" id="deleteCancelBtn">Cancel</button>
      <button class="btn-danger" id="deleteConfirmBtn">Delete Product</button>
    </div>
  </div>
</div>

<div class="toast" id="toast">Saved successfully</div>

<script src="/js/farmerJs/allProduct.js"></script>
</body>
</html>
